# Template for Timeweb App Platform / Docker Hub. Do not commit the filled file.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# Enable only behind the provider's trusted reverse proxy; restrict direct port 8000.
TRUST_PROXY_HEADERS=true
WEBAPP_URL=https://replace-with-your-technical-domain.invalid
ADMIN_USERNAME=store-owner
ADMIN_PASSWORD=replace-with-a-unique-long-password
# EXISTING shop: copy its current master key. NEW empty shop: generate once.
STORE_MASTER_KEY=replace-with-the-existing-or-a-new-persistent-random-key

# External PostgreSQL. localhost would refer to the app container itself.
POSTGRESQL_HOST=replace-with-the-database-hostname
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=default_db
POSTGRESQL_USER=replace-with-the-database-user
POSTGRESQL_PASSWORD=replace-with-the-database-password
POSTGRESQL_SSLMODE=verify-full
# Paste the provider's full public CA certificate as the variable value in Timeweb.
# A local .env file can use a double-quoted value with escaped \n between lines.
POSTGRESQL_SSLROOTCERT_PEM=
# Alternative on a VPS with a mounted certificate file; use ONE form only:
# POSTGRESQL_SSLROOTCERT=/etc/apex/certs/postgres-root.crt

# App Platform replaces the app filesystem on redeploy: use external S3 media.
STORE_MEDIA_BACKEND=s3
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=replace-with-your-private-bucket
S3_PREFIX=apex/media
S3_ACCESS_KEY_ID=replace-with-the-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-the-s3-secret-key

# Optional bank CA: paste public PEM if standard TLS trust is insufficient.
# TBANK_CA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# CDEK and T-Bank credentials are configured in the admin panel, not this image.
# RabbitMQ is not connected by an environment variable; see RABBITMQ.md.
