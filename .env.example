# Local Docker Compose database. These are documented development defaults.
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ApexStore
POSTGRESQL_USER=apex
POSTGRESQL_PASSWORD=apex-development-password
POSTGRESQL_SSLMODE=disable
APP_HOST=127.0.0.1
APP_PORT=8000
ADMIN_USERNAME=admin
# Generate distinct values before use; never commit real credentials.
ADMIN_PASSWORD=replace-with-a-long-local-password
STORE_MASTER_KEY=replace-with-a-random-persistent-master-key
CAPTCHA_MODE=mock
WEBAPP_URL=http://127.0.0.1:8000
# Real payments need a public HTTPS WEBAPP_URL and bank credentials in admin.
# Optional TLS trust file, when required by the bank:
# TBANK_CA_CERT=/etc/apex/certs/russian_trusted_root_ca.cer
